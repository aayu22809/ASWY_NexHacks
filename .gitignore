# Images (if large test images)
# Uncomment if you have large test images
# *.png
# *.jpg
# *.jpeg

# Videos
*.mp4
*.avi
*.mov
*.wmv

# Secrets and sensitive data
secrets/
*.pem
*.key
*.crt
*_secret*
*_password*

# Local configuration overrides
config/local*.yaml
config/*_local.yaml

# Test outputs
test_output/
test_results/

# Profiling data
*.prof
*.lprof

# Core dumps
core
core.*

# ============================================================================
# Keep Essential Files
# ============================================================================

# Keep example/demo files
!examples/**/*.ply
!examples/**/*.json

# Keep documentation assets
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.svg

# Keep frontend public assets
!frontend/public/**/*
!frontend/src/assets/**/*

# Keep config templates
!config/*.yaml

